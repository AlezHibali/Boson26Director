{
  "name": "ai-director-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "assets:generate": "tsx scripts/generate-actors.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:live:browser": "tsx scripts/live-browser.ts",
    "test": "npm run test:unit",
    "test:api": "vitest run tests/unit/boson.test.ts tests/unit/origin.test.ts tests/unit/takes.test.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "test:stage2": "vitest run tests/unit/scene.test.ts tests/unit/stage-assets.test.ts",
    "test:stage2:e2e": "playwright test studio.spec.ts",
    "test:stage3:browser": "tsx scripts/stage3-browser.ts",
    "test:stage3:e2e": "playwright test voice.spec.ts",
    "test:stage3:live": "tsx scripts/stage3-corpus.ts",
    "test:stage3:report": "tsx scripts/stage3-report.ts",
    "test:stage3:barge": "tsx scripts/stage3-barge.ts",
    "test:stage3": "vitest run tests/unit/voice-tools.test.ts tests/unit/voice-session.test.ts",
    "test:stage4": "vitest run tests/unit/takes.test.ts tests/unit/take-controller.test.ts",
    "test:stage4:e2e": "playwright test takes.spec.ts",
    "test:stage4:live": "tsx scripts/stage4-live.ts",
    "doctor": "tsx scripts/doctor.ts",
    "verify": "tsx scripts/verify.ts",
    "test:demo": "playwright test demo.spec.ts",
    "test:api:http": "playwright test api.spec.ts --project=chromium",
    "release:info": "tsx scripts/release-info.ts",
    "test:stage5:live": "tsx scripts/stage5-live.ts",
    "demo:recover-stage4": "tsx scripts/stage5-cache.ts",
    "test:clean": "pwsh -NoProfile -File scripts/check-clean-install.ps1"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "ws": "^8.19.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
